{
  "name": "carbon-tutorial-web-components",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint:style": "pnpm stylelint '**/*.scss'",
    "preview": "vite preview",
    "lint:spell": "cspell lint --quiet \"**/*.{js,css,scss,md}\"",
    "lint:es": "eslint . main.js --report-unused-disable-directives --max-warnings 0",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint:format": "prettier ./**/*.{js,jsx,ts,tsx,md,mdx,scss} --write --ignore-unknown --no-error-on-unmatched-pattern --log-level warn"
  },
  "devDependencies": {
    "@double-great/stylelint-a11y": "^3.4.1",
    "cspell": "^9.3.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.1",
    "stylelint": "^16.26.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-plugin-carbon-tokens": "^3.2.3",
    "stylelint-use-logical": "^2.1.2",
    "stylelint-use-logical-spec": "^5.0.1",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@carbon/icons": "^11.52.0",
    "@carbon/styles": "^1.69.0",
    "@carbon/web-components": "^2.17.0",
    "@octokit/core": "^6.1.2",
    "sass": "^1.80.4"
  }
}
